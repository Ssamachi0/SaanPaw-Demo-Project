# Copy to .env for local development. See docs/DEPLOYMENT.md for production.

# Server
PORT=4001
NODE_ENV=development
# Browser origins allowed to call the API, comma separated. Empty allows any origin in development
# and none in production (native apps are not affected).
CORS_ORIGINS=
# Reverse proxies in front of the API (0 = none). Set to 1 behind nginx, Caddy or a cloud load balancer.
TRUST_PROXY=0

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/saanpaw

# Auth. Production refuses to start unless JWT_SECRET is a random string of 32+ characters
# (generate one with: openssl rand -hex 32).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# File storage (local disk; mount a persistent volume here in production)
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4001

# Image recognition
IR_MODEL=mobilenet_v3
IR_MATCH_THRESHOLD=0.82
IR_MAX_RESULTS=10

# Smart alert defaults (metres)
DEFAULT_USER_ALERT_RADIUS=3000
DEFAULT_SHELTER_RADIUS=5000

# Moderation
MODERATION_FALSE_REPORT_BAN_THRESHOLD=3
